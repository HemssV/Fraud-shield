# ─── FraudShield — Backend Person B — Environment Variables ───────────────────

# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL)
DATABASE_URL=postgres://fraudshield:password@localhost:5432/fraudshield

# ML Integration
# Set to true to use the mock ML adapter (no real model needed)
USE_MOCK_ML=true

# GenAI (Google Gemini)
# Set to true to use a deterministic fallback instead of calling the API
USE_MOCK_GENAI=true
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Optional: override thresholds for the demo
ML_FRAUD_THRESHOLD=0.5
