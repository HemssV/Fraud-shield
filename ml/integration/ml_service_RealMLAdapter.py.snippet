# ml/integration/ml_service_RealMLAdapter.py.snippet
# Replace the existing RealMLAdapter class in intelligence/services/ml_service.py

import json
import urllib.request
import urllib.error
import logging
from django.conf import settings

log = logging.getLogger(__name__)

class RealMLAdapter:
    """
    Pluggable adapter for the Python ML Service.
    Uses urllib to avoid adding external dependencies like requests.
    """

    def predict(self, ml_input) -> 'MLOutput':
        url = getattr(settings, 'ML_SERVICE_URL', 'http://localhost:8001') + '/predict'
        
        payload = {
            "shipment_id": ml_input.shipment_id,
            "features": ml_input.features
        }
        
        data = json.dumps(payload).encode('utf-8')
        req = urllib.request.Request(url, data=data, headers={'Content-Type': 'application/json'})
        
        try:
            # 2 second timeout
            with urllib.request.urlopen(req, timeout=2.0) as response:
                result = json.loads(response.read().decode())
                
                # Assume MLOutput is available in the module scope
                return MLOutput(
                    fraud_probability=result.get("fraud_probability", 0.5),
                    risk_score=result.get("risk_score", 50.0),
                    risk_level=result.get("risk_level", "MEDIUM"),
                    top_reasons=result.get("top_reasons", ["unknown"]),
                    raw=result
                )
        except urllib.error.URLError as e:
            log.error(f"ML Service connection error for {ml_input.shipment_id}: {e}")
            raise Exception(f"ML Service connection error: {e}")
        except Exception as e:
            log.error(f"ML Service unexpected error for {ml_input.shipment_id}: {e}")
            raise
